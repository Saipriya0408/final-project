# SymptoCare Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
DEBUG=False
HOST=0.0.0.0

# Data paths (relative to backend/ directory)
DATA_DIR=./data
DOCTORS_DB_PATH=./database/doctors.json
HOSPITALS_DB_PATH=./database/hospitals.json

# ML Model settings
MAX_SYMPTOMS=5
MIN_SYMPTOMS=1

# Doctor/Hospital search defaults
DEFAULT_SEARCH_RADIUS_KM=25
MAX_RESULTS_DOCTORS=20
MAX_RESULTS_HOSPITALS=10
DEFAULT_CITY=Chennai

# CORS - comma-separated origins (use * for development)
ALLOWED_ORIGINS=*
