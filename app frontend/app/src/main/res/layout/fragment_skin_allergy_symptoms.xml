<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Skin Allergy Analysis"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Help us understand your symptoms better by selecting the options below."
        android:textColor="@color/text_desc"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAnalyze"
        app:layout_constraintTop_toBottomOf="@id/tvDesc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select your symptoms"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/sympRedness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Redness"
                    android:textColor="@color/text_desc"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sympItching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Itching"
                    android:textColor="@color/text_desc"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/sympRash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Rash"
                    android:textColor="@color/text_desc"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sympSwelling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Swelling"
                    android:textColor="@color/text_desc"
                    android:textSize="14sp" />
                    
                <TextView
                    android:id="@+id/sympDrySkin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Dry Skin"
                    android:textColor="@color/text_desc"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_image_placeholder"
                android:src="@android:color/transparent" /> <!-- Placeholder for phone photo -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Photo"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture a clear image of the affected area for a more accurate digital assessment."
                android:textColor="@color/text_desc"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />
                
            <TextView
                android:id="@+id/btnUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_camera"
                android:text=" Select Image"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:padding="16dp"
        android:text="Proceed to Analysis ➔"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
