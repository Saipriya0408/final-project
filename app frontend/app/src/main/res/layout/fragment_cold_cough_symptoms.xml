<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STEP 2 OF 3"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />
        
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Identify Symptoms"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvStep" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Please select all symptoms that apply to your current condition for a more accurate analysis."
        android:textColor="@color/text_desc"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAnalyze"
        app:layout_constraintTop_toBottomOf="@id/tvDesc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dry Cough -->
            <CheckBox
                android:id="@+id/cbDryCough"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Dry Cough\nPersistent cough without phlegm"
                android:textColor="@color/text_title" />

            <!-- Sore Throat -->
            <CheckBox
                android:id="@+id/cbSoreThroat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Sore Throat\nPain, itchiness, or irritation"
                android:textColor="@color/text_title" />

            <!-- Runny Nose -->
            <CheckBox
                android:id="@+id/cbRunnyNose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Runny Nose\nExcess nasal drainage"
                android:textColor="@color/text_title" />
                
            <!-- Fever -->
            <CheckBox
                android:id="@+id/cbFever"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Fever\nHigher than normal body temp"
                android:textColor="@color/text_title" />

            <!-- Fatigue -->
            <CheckBox
                android:id="@+id/cbFatigue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Fatigue\nExtreme tiredness or low energy"
                android:textColor="@color/text_title" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:padding="16dp"
        android:text="Proceed to Analysis ➔"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
