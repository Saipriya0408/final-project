<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:padding="16dp">

    <TextView
        android:id="@+id/ivAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_light_blue"
        android:gravity="center"
        android:text="DSJ"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDrName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/dr_name_1"
        android:textColor="@color/text_title"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar" />

    <TextView
        android:id="@+id/tvDrSpec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dr_spec_1"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/tvDrName"
        app:layout_constraintTop_toBottomOf="@+id/tvDrName" />

    <TextView
        android:id="@+id/tvRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⭐ 4.9 (248)  📍 0.8 km"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/tvDrName"
        app:layout_constraintTop_toBottomOf="@+id/tvDrSpec" />

    <TextView
        android:id="@+id/tvAvailableBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_green"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/available"
        android:textColor="@color/white"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/bg_gray"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivAvatar">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/experience"
                android:textColor="@color/text_desc"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvExperience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 years"
                android:textColor="@color/text_title"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/consultation_fee"
                android:textColor="@color/text_desc"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$80"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvAvailableToday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🕒 Available Today"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutDetails" />

    <LinearLayout
        android:id="@+id/layoutTimes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAvailableToday">

        <TextView
            android:id="@+id/tvTime1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_blue"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="10:00 AM"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTime2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_blue"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="2:00 PM"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />
            
        <TextView
            android:id="@+id/tvTime3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_blue"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="4:30 PM"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTimes">

        <TextView
            android:id="@+id/btnBook"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_light_blue"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="📅 Book"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_outline_blue"
            android:padding="8dp"
            android:src="@drawable/ic_phone" />

        <ImageView
            android:id="@+id/btnNavigate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_outline_green"
            android:padding="8dp"
            android:src="@drawable/ic_paper_plane" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
