<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Describe your headache"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select the symptoms that best describe your current condition to help us provide a preliminary analysis."
        android:textColor="@color/text_desc"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAnalyze"
        app:layout_constraintTop_toBottomOf="@id/tvDesc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:background="@color/white"
                android:src="@drawable/bg_green_map_placeholder" /> <!-- Placeholder for head image -->

            <!-- Migraine -->
            <CheckBox
                android:id="@+id/cbMigraine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Migraine\nSevere throbbing pain, usually on one side, often with nausea and sensitivity to light."
                android:textColor="@color/text_title" />

            <!-- Tension -->
            <CheckBox
                android:id="@+id/cbTension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Tension\nA constant ache or pressure around the head, especially at the temples or back of the head and neck."
                android:textColor="@color/text_title" />

            <!-- Cluster -->
            <CheckBox
                android:id="@+id/cbCluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:text="Cluster\nSevere pain in or around one eye, often in cyclical patterns or clusters."
                android:textColor="@color/text_title" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:padding="16dp"
        android:text="Analyze Symptoms"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
