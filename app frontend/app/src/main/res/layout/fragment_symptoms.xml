<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <!-- Top Header Area -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_top_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_icon_blue"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/describe_symptoms"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvHeaderDesc"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/btnBack"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvHeaderDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/describe_symptoms_desc"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="@+id/tvHeaderTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle" />

    <!-- Toggle Buttons -->
    <LinearLayout
        android:id="@+id/toggleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_toggle_container"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="@+id/headerBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBg">

        <TextView
            android:id="@+id/tabTextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_toggle_active"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="✍ Text Input"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSymptomIcons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_toggle_inactive"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="🩺 Symptom Icons"
            android:textColor="@color/text_desc"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnGuidedAssessment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleContainer">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TEXT INPUT LAYOUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:padding="20dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvTextInputTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/describe_your_symptoms"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etSymptoms"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:hint="@string/symptom_text_hint"
                    android:padding="16dp"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/input_hint"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTextInputTitle" />

                <TextView
                    android:id="@+id/tvCommonSymptomsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Common Symptoms"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etSymptoms" />

                <HorizontalScrollView
                    android:id="@+id/scrollChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@+id/tvCommonSymptomsTitle">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFever"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_outline_blue"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Fever"
                            android:textColor="@color/primary_blue" />

                        <TextView
                            android:id="@+id/chipCough"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_outline_blue"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Cough"
                            android:textColor="@color/primary_blue" />

                        <TextView
                            android:id="@+id/chipHeadache"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_outline_blue"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Headache"
                            android:textColor="@color/primary_blue" />

                        <TextView
                            android:id="@+id/chipFatigue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_button_outline_blue"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Fatigue"
                            android:textColor="@color/primary_blue" />
                    </LinearLayout>
                </HorizontalScrollView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- SYMPTOM ICONS LAYOUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutSymptomIcons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSelectSymptomsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_your_symptoms"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Grid using GridLayout -->
                <GridLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="2"
                    android:useDefaultMargins="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvSelectSymptomsTitle">

                    <!-- Fever -->
                    <LinearLayout
                        android:id="@+id/symptom_fever"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_red"
                            android:padding="8dp"
                            android:src="@drawable/ic_thermometer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_fever"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Headache -->
                    <LinearLayout
                        android:id="@+id/symptom_headache"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_purple"
                            android:padding="8dp"
                            android:src="@drawable/ic_brain" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_headache"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Chest Pain -->
                    <LinearLayout
                        android:id="@+id/symptom_chest_pain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_blue"
                            android:padding="8dp"
                            android:src="@drawable/ic_heart" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_chest_pain"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Cough -->
                    <LinearLayout
                        android:id="@+id/symptom_cough"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_blue"
                            android:padding="8dp"
                            android:src="@drawable/ic_water_drop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_cough"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Stomach Pain -->
                    <LinearLayout
                        android:id="@+id/symptom_stomach_pain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_orange"
                            android:padding="8dp"
                            android:src="@drawable/ic_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_stomach_pain"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Fatigue -->
                    <LinearLayout
                        android:id="@+id/symptom_fatigue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_blue"
                            android:padding="8dp"
                            android:src="@drawable/ic_pulse" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_fatigue"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Eye Problem -->
                    <LinearLayout
                        android:id="@+id/symptom_eye_problem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_green"
                            android:padding="8dp"
                            android:src="@drawable/ic_eye" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_eye_problem"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Breathing Issue -->
                    <LinearLayout
                        android:id="@+id/symptom_breathing_issue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_blue"
                            android:padding="8dp"
                            android:src="@drawable/ic_wind" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_breathing_issue"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>
                    
                    <!-- Ear Pain -->
                    <LinearLayout
                        android:id="@+id/symptom_ear_pain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_orange"
                            android:padding="8dp"
                            android:src="@drawable/ic_ear" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_ear_pain"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Skin Problem -->
                    <LinearLayout
                        android:id="@+id/symptom_skin_problem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_red"
                            android:padding="8dp"
                            android:src="@drawable/ic_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/symp_skin_problem"
                            android:textColor="@color/text_title"
                            android:textSize="12sp" />
                    </LinearLayout>

                </GridLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/btnGuidedAssessment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_outline_blue"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAnalyze"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/primary_blue" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Not sure? Start Guided Scan"
            android:textColor="@color/primary_blue"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAnalyze"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="✨ Analyze Symptoms"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
