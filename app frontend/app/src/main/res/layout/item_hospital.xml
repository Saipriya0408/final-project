<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp">

    <!-- Map Header in Card -->
    <FrameLayout
        android:id="@+id/cardMap"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_hospital_card_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_location_pin"
            app:tint="#80FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEmergencyBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_badge_red"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="🕒 24/7 Emergency"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Details -->
    <TextView
        android:id="@+id/tvHospName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/hospital_name_1"
        android:textColor="@color/text_title"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardMap" />

    <TextView
        android:id="@+id/tvHospRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⭐ 4.8 (542)  📍 1.2 km"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/tvHospName"
        app:layout_constraintTop_toBottomOf="@+id/tvHospName" />

    <TextView
        android:id="@+id/tvHospAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hospital_address_1"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvHospName"
        app:layout_constraintTop_toBottomOf="@+id/tvHospRating" />

    <TextView
        android:id="@+id/tvDepartmentsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/departments"
        android:textColor="@color/text_desc"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/tvHospName"
        app:layout_constraintTop_toBottomOf="@+id/tvHospAddress" />

    <LinearLayout
        android:id="@+id/layoutDepts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvHospName"
        app:layout_constraintTop_toBottomOf="@+id/tvDepartmentsLabel">

        <TextView
            android:id="@+id/tvDept1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_gray"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Cardiology"
            android:textColor="@color/primary_blue"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDept2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_gray"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Neurology"
            android:textColor="@color/primary_blue"
            android:textSize="10sp" />
            
        <TextView
            android:id="@+id/tvDept3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_gray"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Orthopedics"
            android:textColor="@color/primary_blue"
            android:textSize="10sp" />
            
        <TextView
            android:id="@+id/tvDeptMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/bg_gray"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="+2 more"
            android:textColor="@color/text_desc"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutDepts">

        <TextView
            android:id="@+id/btnDirections"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_green"
            android:drawableStart="@drawable/ic_directions"
            android:drawablePadding="8dp"
            android:drawableTint="@color/white"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/get_directions"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_outline_blue"
            android:padding="12dp"
            android:src="@drawable/ic_phone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
